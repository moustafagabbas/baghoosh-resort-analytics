	measure 'P2 Avg Predicted Market Price' = AVERAGE ( P2_Pricing[Predicted Market Price] )
		formatString: #,0
		lineageTag: 5ebaa495-eca4-4b35-b35e-4c387659a1f0

	measure 'P2 Avg Recommended Launch Price' = AVERAGE ( P2_Pricing[Recommended Launch Price] )
		formatString: #,0
		lineageTag: 4caa0d1c-26fc-41d8-9d15-da3ae8a7178e

	measure 'Measure 5'
		lineageTag: c8b87b0b-0f4b-4192-9eb4-b976f1d07c7a

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'P2 Recommended Price per sqm' = ```
			
			    DIVIDE ( SUM ( P2_Pricing[Recommended Launch Price] ), SUM ( P2_Pricing[Built-up Area sqm] ) )
			```
		formatString: #,0
		lineageTag: 445057c7-e97b-4d1c-8f68-a3203cdef4a8

	measure 'P2 Phase 1 Comparable per sqm' = AVERAGE ( P2_Pricing[Phase 1 Comparable Price per sqm] )
		formatString: #,0
		lineageTag: 40181f8c-140b-4f57-b609-4d1f241ef0cb

	measure 'P2 Expected Gross Margin' = ```
			
			    DIVIDE ( SUM ( P2_Pricing[Recommended Launch Price] ) - SUM ( P2_Pricing[Forecast Development Cost] ),
			             SUM ( P2_Pricing[Recommended Launch Price] ) )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5a84456d-c22a-49b4-bdbb-ca4b1649aae6

	measure 'P2 Launch Premium vs Phase 1' = DIVIDE ( [P2 Recommended Price per sqm], [P2 Phase 1 Comparable per sqm] ) - 1
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bb7a9c0e-1f19-4fed-9ac2-56023631fe3b

	measure 'P2 Cost Increase %' = MAX ( P2_Pricing[Forecast Construction Cost Increase %] )
		formatString: 0.0%;-0.0%;0.0%
