	measure 'Enquiry to Viewing %' = DIVIDE ( [Viewings], [Enquiries] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: aeba987d-1422-41ca-9010-c634ee82bb65

	measure Sales = COUNTROWS ( Fact_Sales )
		formatString: 0
		lineageTag: a0268ce9-a0ab-472c-bbb3-c727b3de1a73

	measure 'Sales Value' = SUM ( Fact_Sales[Contract Price] )
		formatString: #,0
		lineageTag: 37b2a3b3-e76a-4b49-9dd3-c76b84508ea2

	measure Reservations = COUNTROWS ( Fact_Reservations )
		formatString: 0
