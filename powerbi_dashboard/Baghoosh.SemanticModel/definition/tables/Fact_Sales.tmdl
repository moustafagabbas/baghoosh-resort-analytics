	column 'Lead Source' = ```
			
			VAR _LeadID =
			    LOOKUPVALUE (
			        Fact_Reservations[Lead ID],
			        Fact_Reservations[Reservation ID], 
			        Fact_Sales[Reservation ID]
			    )
			RETURN
			    LOOKUPVALUE (
			        Fact_Leads[Lead Source],
			        Fact_Leads[Lead ID], 
			        _LeadID
			    )
			```
		lineageTag: 698c3545-72bb-4e80-bc37-ba16a9e9553b
		summarizeBy: none

