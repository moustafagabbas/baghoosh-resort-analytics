	measure 'Average Annual Rent' = AVERAGE ( P1_Investment[Expected Annual Rental Value] )
		formatString: #,0
		lineageTag: 5c216022-e629-4219-a5bd-36f0a18c69c3

	measure 'Average Value at Handover' = AVERAGE ( P1_Investment[Estimated Value at Handover] )
		formatString: #,0
