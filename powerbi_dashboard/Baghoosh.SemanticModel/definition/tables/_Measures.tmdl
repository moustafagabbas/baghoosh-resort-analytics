		lineageTag: a0cd06fe-3284-4844-80a3-78d77d78ea27

	measure 'Average Discount vs List' = AVERAGE ( Fact_Sales[Discount vs List %] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fa994ce0-67db-44a0-b7bc-ac7aecf7ab70

	measure 'Average Days on Market (Sold)' = ```
			
			    CALCULATE ( AVERAGE ( Unit_Features[Days on Market] ), Unit_Features[Sales Status] = "Sold" )
			```
		formatString: 0
		lineageTag: c90662ad-4aee-4296-8211-f48a7a258225

	measure 'Average Days on Market (Unsold)' = ```
			
			    CALCULATE ( AVERAGE ( Unit_Features[Days on Market] ), Unit_Features[Sales Status] = "Unsold" )
			```
		formatString: 0
		lineageTag: 9b7b09f6-c6cd-4415-8ed7-140ca20af66b

	measure 'Slow-Moving Units' = ```
			
			    CALCULATE ( COUNTROWS ( Unit_Features ),
			                Unit_Features[Sales Status] = "Unsold", Unit_Features[Days on Market] > 365 )
			```
		formatString: 0
		lineageTag: e452b080-e5ab-4ce3-8a0c-d0f38eb86dfa

	measure 'Average Rental Yield' = AVERAGE ( P1_Investment[Estimated Rental Yield %] )
