	measure 'Measure 3'
		lineageTag: 19fc2282-610c-423f-9608-e7767a00193a

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'P2 Forecast Development Cost' = SUM ( P2_Pricing[Forecast Development Cost] )
		formatString: #,0
