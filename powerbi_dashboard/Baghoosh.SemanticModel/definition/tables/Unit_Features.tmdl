	column 'Pricing Competitiveness Score (bins)' =
			IF(
				ISBLANK('Unit_Features'[Pricing Competitiveness Score]),
				BLANK(),
				IF(
					'Unit_Features'[Pricing Competitiveness Score] >= 0,
					ROUNDDOWN('Unit_Features'[Pricing Competitiveness Score] / 20, 0) * 20,
					ROUNDUP('Unit_Features'[Pricing Competitiveness Score] / 20, 0) * 20
