table _Measures
	lineageTag: 04e8197a-9665-45c1-959c-10f454c7b226

	measure 'Total Units' = COUNTROWS(Dim_Unit)
		formatString: 0
		lineageTag: 92791398-b24e-4637-9aca-afedcaa88143

	measure 'Phase 1 Units' = CALCULATE( [Total Units], Dim_Unit[Phase] = 1 )
		formatString: 0
		lineageTag: 5d0cba96-f546-49d4-951f-7a6698a3aa8b

	measure 'Phase 2 Units' = CALCULATE ( [Total Units], Dim_Unit[Phase] = 2 )
		formatString: 0
		lineageTag: dde33f7d-5667-43d1-a5fd-5151ddff49ef

	measure 'Available Units' = CALCULATE ( [Total Units], Dim_Unit[Availability Status] = "Available" )
		formatString: 0
		lineageTag: 64ec0684-f33b-49df-a034-dc8d92123baf

	measure 'Reserved Units' = CALCULATE ( [Total Units], Dim_Unit[Availability Status] = "Reserved" )
		formatString: 0
		lineageTag: 6f95d8fe-a1a0-4dd6-b314-0608043f0e5c

	measure 'Sold Units' = CALCULATE ( [Total Units], Dim_Unit[Availability Status] = "Sold" )
		formatString: 0
		lineageTag: cfd8fe81-03d9-441c-bc22-c979c389c936

	measure 'Planned Units' = CALCULATE ( [Total Units], Dim_Unit[Availability Status] = "Planned" )
		formatString: 0
		lineageTag: e58f9cec-69ca-45a5-a71e-ebd0529bfcea

	measure 'Sold Share of Phase 1' = DIVIDE ( [Sold Units], [Phase 1 Units] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 17fb550c-2aae-4f45-80e7-f890c2abac97

	measure 'Inventory Value' = ```
			
			    CALCULATE ( SUM ( Fact_Unit_Pricing[List Price] ), Dim_Unit[Availability Status] = "Available" )
			```
		formatString: #,0
		lineageTag: 4293c0e8-e098-4586-b50f-bb7c0e1e5d76

	measure 'Average List Price' = AVERAGE ( Fact_Unit_Pricing[List Price] )
		formatString: #,0
		lineageTag: 678f0e8c-ead6-4e6c-aeac-ea81611701c0

	measure 'Median List Price' = MEDIAN ( Fact_Unit_Pricing[List Price] )
		formatString: #,0
		lineageTag: 754bdc70-98ca-42b0-8567-df401e8b18c9

	measure 'Average Price per sqm' = AVERAGE ( Fact_Unit_Pricing[Price per sqm] )
		formatString: #,0
		lineageTag: 3e6a692c-99ea-4652-ade1-b4b21e84f146

	measure 'Average Selling Price' = AVERAGE ( Fact_Sales[Contract Price] )
		formatString: #,0
		lineageTag: 08548108-3ea1-45b7-8b27-59ca889606c1

	measure 'Average Development Cost' = AVERAGE ( Fact_Unit_Cost[Total Development Cost] )
		formatString: #,0
		lineageTag: f0ceba7f-b459-48c5-84e3-3a50410144cc

	measure 'Average Dev Cost per sqm' = AVERAGE ( Fact_Unit_Cost[Development Cost per sqm] )
		formatString: #,0
		lineageTag: a13a714e-2ec3-4271-bc8b-7b48a6ee814b

	measure 'Average Gross Profit' = AVERAGE ( Fact_Unit_Pricing[Gross Profit] )
		formatString: #,0
		lineageTag: 490a996d-2dbf-435c-be3b-75f0870a9dc8

	measure 'Average Gross Margin' = AVERAGE ( Fact_Unit_Pricing[Gross Margin %] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a1defeb4-9e4d-4e59-833b-68ecce7e4ab6

	measure 'Average Competitiveness' = AVERAGE ( Unit_Features[Pricing Competitiveness Score] )
		formatString: 0.0
		lineageTag: 74323953-a199-4a0f-ade0-388e90901e2d

	measure 'Priced Units' = COUNTROWS ( Fact_Unit_Pricing )
		formatString: 0
		lineageTag: 192c3ff6-1f73-4c51-ae7e-60f304b81494

	measure 'Average Phase 1 Development Cost' = ```
			
			    CALCULATE ( [Average Development Cost], Dim_Unit[Phase] = 1 )
			```
		formatString: #,0
		lineageTag: f20ac7cf-3c6a-4566-acbe-891099d33f12

	measure 'Sea View Premium %' = ```
			
			    DIVIDE (
			        CALCULATE ( [Average Price per sqm], Dim_Unit[Sea View] = "Yes" ),
			        CALCULATE ( [Average Price per sqm], Dim_Unit[Sea View] = "No" )
			    ) - 1
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 66b4c703-b3c3-4222-8792-c1333fdd2b60

	measure Enquiries = COUNTROWS ( Fact_Leads )
		formatString: 0
